{
  "name": "ugc-ads",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "tsx --env-file=.env.local src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "preflight": "tsx --env-file-if-exists=.env.local scripts/preflight.ts",
    "dev:all": "npm run preflight && concurrently --kill-others-on-fail --names web,worker --prefix-colors cyan,magenta \"next dev\" \"npm run worker\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@google/genai": "^2.28.0",
    "@resvg/resvg-js": "^2.6.2",
    "archiver": "^8.0.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "^0.49.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
