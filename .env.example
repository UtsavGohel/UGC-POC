# Postgres (Neon or Supabase). Use the DIRECT / session connection string,
# not a transaction pooler (pg-boss needs session-level features).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Google AI Studio API key (billing enabled for images and video)
GEMINI_API_KEY=

# Where generated files are stored (relative to the project root)
STORAGE_DIR=./storage

# Optional model overrides
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# VEO_MODEL=veo-3.1-lite-generate-preview
# VIDEO_RESOLUTION=720p

# Cost controls (defaults shown)
# STATIC_SCENE_MODE=shared      # one AI scene per angle for all 3 sizes; "per_ratio" = one per size (3x cost)
# MAX_BATCH_USD=2               # max estimated spend a single "Generate" click may queue
# PRODUCT_VIDEO_VEO_CLIPS=1     # paid Veo shots per product video (2 = smoother, ~2x video cost)
# VEO_MAX_CONCURRENCY=2         # Veo renders at once; use 1 on a new/low-quota Google account
# WORKER_POLL_SECONDS=15        # idle queue polling; new jobs wake the worker instantly
